[Unit]
Description=FuRun arbitrage dispatcher
After=network.target redis.service furun-arb-scanner.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/furunsystemv4/current
EnvironmentFile=/home/ubuntu/furunsystemv4/current/.env.worker
ExecStart=/home/ubuntu/furunsystemv4/current/.venv/bin/python -m app.runtime.worker_service --role arb_dispatcher
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
